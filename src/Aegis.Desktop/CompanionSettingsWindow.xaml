<Window x:Class="Aegis.Desktop.CompanionSettingsWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aegis · 고정 신호 설정" Width="700" Height="430" MinWidth="520" MinHeight="330"
        Icon="/Aegis.Desktop;component/Assets/Aegis.ico" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PinSurface}" Foreground="{DynamicResource PinInk}">
    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{DynamicResource PinInk}"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource PinBar}"/>
            <Setter Property="Foreground" Value="{DynamicResource PinInk}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource PinInk}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PinRule}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource PinAccent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{DynamicResource PinBar}"/>
            <Setter Property="Foreground" Value="{DynamicResource PinInk}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PinRule}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource PinInk}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PinRaised}"/>
                    <Setter Property="Foreground" Value="{DynamicResource PinRaisedInk}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PinSelection}"/>
                    <Setter Property="Foreground" Value="{DynamicResource PinSelectionInk}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource PinAccent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource PinBar}"/>
            <Setter Property="Foreground" Value="{DynamicResource PinInk}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PinRule}"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                CornerRadius="4" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PinRaised}"/>
                    <Setter Property="Foreground" Value="{DynamicResource PinRaisedInk}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PinSelection}"/>
                    <Setter Property="Foreground" Value="{DynamicResource PinSelectionInk}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource PinAccent}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{DynamicResource PinSurface}"/>
                    <Setter Property="Foreground" Value="{DynamicResource PinDisabledInk}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="첫 번째 고정 신호를 오버레이에 크게 표시합니다. 변경은 즉시 저장됩니다."
                   TextWrapping="Wrap" Margin="0,0,0,12" />
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <DockPanel LastChildFill="True">
                <Label x:Name="SearchLabel" DockPanel.Dock="Top" Target="{Binding ElementName=Search}" Content="_S 신호 검색" Padding="0,0,0,4"/>
                <TextBox x:Name="Search" DockPanel.Dock="Top" TextChanged="SearchChanged"
                         AutomationProperties.AutomationId="CompanionTagSearch" Margin="0,0,0,8" Padding="5"/>
                <Button x:Name="AddPin" DockPanel.Dock="Bottom" Click="AddClicked" Padding="8,4" Margin="0,8,0,0"
                        Content="고정" AutomationProperties.AutomationId="CompanionAddPin" />
                <ListBox x:Name="Available" DisplayMemberPath="Caption" SelectionChanged="SelectionChanged"
                         AutomationProperties.Name="고정 가능한 신호" AutomationProperties.AutomationId="CompanionAvailableSignals" />
            </DockPanel>
            <DockPanel Grid.Column="2" LastChildFill="True">
                <Label DockPanel.Dock="Top" Content="고정된 신호" Target="{Binding ElementName=Pinned}" Padding="0,0,0,4"/>
                <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <Button x:Name="RemovePin" Click="RemoveClicked" Content="고정 해제" Padding="8,4" Margin="0,0,5,0"
                            AutomationProperties.AutomationId="CompanionRemovePin" />
                    <Button x:Name="MoveUp" Click="UpClicked" Content="위로" Padding="8,4" Margin="0,0,5,0"
                            AutomationProperties.AutomationId="CompanionMovePinUp" />
                    <Button x:Name="MoveDown" Click="DownClicked" Content="아래로" Padding="8,4"
                            AutomationProperties.AutomationId="CompanionMovePinDown" />
                </WrapPanel>
                <ListBox x:Name="Pinned" DisplayMemberPath="Caption" SelectionChanged="SelectionChanged"
                         AutomationProperties.Name="고정된 신호" AutomationProperties.AutomationId="CompanionPinnedSignals" />
            </DockPanel>
        </Grid>
        <TextBlock Grid.Row="2" x:Name="Status" AutomationProperties.LiveSetting="Polite" Foreground="{DynamicResource PinMuted}"
                   Margin="0,12,0,0" TextWrapping="Wrap" />
    </Grid>
</Window>
