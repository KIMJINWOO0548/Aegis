<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Feather Icons by Cole Bemis, MIT: https://github.com/feathericons/feather
         Original SVGs and license are preserved in Assets/Icons/. -->
    <RectangleGeometry x:Key="IconViewport" Rect="0,0,24,24" />
    <Pen x:Key="IconPen" Brush="#566575" Thickness="2"
         StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
    <Pen x:Key="InfoIconPen" Brush="#2D7FC4" Thickness="2"
         StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
    <Pen x:Key="WhiteIconPen" Brush="White" Thickness="2"
         StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
    <Pen x:Key="CaptionIconPen" Brush="#718092" Thickness="2"
         StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />

    <GeometryGroup x:Key="FeatherLinkGeometry">
        <PathGeometry Figures="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
        <PathGeometry Figures="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
    </GeometryGroup>

    <DrawingImage x:Key="LinkIcon">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="{StaticResource IconViewport}" />
                <GeometryDrawing Pen="{StaticResource IconPen}" Geometry="{StaticResource FeatherLinkGeometry}" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <DrawingImage x:Key="AnalysisIcon">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="{StaticResource IconViewport}" />
                <GeometryDrawing Pen="{StaticResource IconPen}" Geometry="M18 20L18 10 M12 20L12 4 M6 20L6 14" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <DrawingImage x:Key="DatabaseIcon">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="{StaticResource IconViewport}" />
                <GeometryDrawing Pen="{StaticResource IconPen}">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <EllipseGeometry Center="12,5" RadiusX="9" RadiusY="3" />
                            <PathGeometry Figures="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3" />
                            <PathGeometry Figures="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <DrawingImage x:Key="ClockIcon">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="{StaticResource IconViewport}" />
                <GeometryDrawing Pen="{StaticResource IconPen}">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <EllipseGeometry Center="12,12" RadiusX="10" RadiusY="10" />
                            <PathGeometry Figures="M12 6L12 12 16 14" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <DrawingImage x:Key="DocumentIcon">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="{StaticResource IconViewport}" />
                <GeometryDrawing Pen="{StaticResource IconPen}">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <PathGeometry Figures="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                            <PathGeometry Figures="M14 2L14 8 20 8 M16 13L8 13 M16 17L8 17 M10 9L9 9 8 9" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <DrawingImage x:Key="InfoIcon">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="{StaticResource IconViewport}" />
                <GeometryDrawing Pen="{StaticResource InfoIconPen}">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <EllipseGeometry Center="12,12" RadiusX="10" RadiusY="10" />
                            <PathGeometry Figures="M12 16L12 12 M12 8L12.01 8" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <DrawingImage x:Key="LinkWhiteIcon">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="{StaticResource IconViewport}" />
                <GeometryDrawing Pen="{StaticResource WhiteIconPen}" Geometry="{StaticResource FeatherLinkGeometry}" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <DrawingImage x:Key="MinimizeIcon">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="{StaticResource IconViewport}" />
                <GeometryDrawing Pen="{StaticResource CaptionIconPen}" Geometry="M5 12L19 12" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <DrawingImage x:Key="MaximizeIcon">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="{StaticResource IconViewport}" />
                <GeometryDrawing Pen="{StaticResource CaptionIconPen}">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="3,3,18,18" RadiusX="2" RadiusY="2" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <DrawingImage x:Key="CloseIcon">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="{StaticResource IconViewport}" />
                <GeometryDrawing Pen="{StaticResource CaptionIconPen}" Geometry="M18 6L6 18 M6 6L18 18" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <DrawingImage x:Key="RestoreIcon">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="{StaticResource IconViewport}" />
                <GeometryDrawing Pen="{StaticResource CaptionIconPen}">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <RectangleGeometry Rect="9,9,13,13" RadiusX="2" RadiusY="2" />
                            <PathGeometry Figures="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
</ResourceDictionary>
