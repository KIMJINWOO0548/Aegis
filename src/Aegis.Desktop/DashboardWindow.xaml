<Window x:Class="Aegis.Desktop.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:local="clr-namespace:Aegis.Desktop"
        Title="{x:Static local:DashboardEndpoint.DefaultCaption}" Icon="/Aegis.Desktop;component/Assets/Aegis.ico"
        Width="1440" Height="900" MinWidth="640" MinHeight="480"
        Background="{DynamicResource InstrumentSurface}" WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource AppFont}" UseLayoutRounding="True"
        Loaded="WindowLoaded" Closed="WindowClosed">
    <Window.Resources>
        <SolidColorBrush x:Key="InstrumentSurface" Color="#101B27" />
        <SolidColorBrush x:Key="InstrumentBar" Color="#14212E" />
        <SolidColorBrush x:Key="InstrumentRaised" Color="#1D3440" />
        <SolidColorBrush x:Key="InstrumentRule" Color="#3B5465" />
        <SolidColorBrush x:Key="InstrumentInk" Color="#E6EFF5" />
        <SolidColorBrush x:Key="InstrumentMuted" Color="#B9CCD9" />
        <SolidColorBrush x:Key="InstrumentAccent" Color="#71E8D4" />
        <SolidColorBrush x:Key="InstrumentSelection" Color="#18343C" />
        <Style x:Key="InstrumentCommand" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource InstrumentRule}" />
            <Setter Property="Foreground" Value="{DynamicResource InstrumentInk}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Frame" Background="{TemplateBinding Background}" CornerRadius="4"
                                BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource InstrumentRaised}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource InstrumentAccent}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource InstrumentAccent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="InstrumentThemeChoice" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource InstrumentInk}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Choice" CornerRadius="4" BorderThickness="1"
                                BorderBrush="Transparent" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Choice" Property="Background" Value="{DynamicResource InstrumentRaised}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Choice" Property="Background" Value="{DynamicResource InstrumentSelection}" />
                                <Setter TargetName="Choice" Property="BorderBrush" Value="{DynamicResource InstrumentAccent}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Choice" Property="BorderBrush" Value="{DynamicResource InstrumentAccent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border x:Name="CompanionToolbar" Visibility="Collapsed" Background="{DynamicResource InstrumentBar}"
                BorderBrush="{DynamicResource InstrumentRule}" BorderThickness="0,0,0,1" Padding="12,4">
            <StackPanel>
            <DockPanel KeyboardNavigation.TabNavigation="Continue">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0"
                            AutomationProperties.Name="표시 테마">
                    <TextBlock Text="테마" Foreground="{DynamicResource InstrumentMuted}"
                               FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center" />
                    <RadioButton x:Name="DarkThemeButton" Style="{StaticResource InstrumentThemeChoice}"
                                 GroupName="WorkbenchTheme" Content="다크" Tag="Dark"
                                 AutomationProperties.AutomationId="ThemeDark" Checked="ThemeChecked" />
                    <RadioButton x:Name="LightThemeButton" Style="{StaticResource InstrumentThemeChoice}"
                                 GroupName="WorkbenchTheme" Content="라이트" Tag="Light"
                                 AutomationProperties.AutomationId="ThemeLight" Checked="ThemeChecked" />
                    <RadioButton x:Name="WarmThemeButton" Style="{StaticResource InstrumentThemeChoice}"
                                 GroupName="WorkbenchTheme" Content="따뜻한 톤" Tag="Warm"
                                 AutomationProperties.AutomationId="ThemeWarm" Checked="ThemeChecked" />
                </StackPanel>
                <WrapPanel>
                <Button x:Name="ToggleOverlayButton" AutomationProperties.AutomationId="ToggleCompanionOverlay"
                        Style="{StaticResource InstrumentCommand}" Content="오버레이 켜기"
                        Click="ToggleOverlayClicked" Margin="0,0,6,0" />
                <Button AutomationProperties.AutomationId="OpenCompanionSettings"
                        Style="{StaticResource InstrumentCommand}" Content="고정 신호 설정"
                        Click="CompanionSettingsClicked" Margin="0,0,6,0" />
                <Button AutomationProperties.AutomationId="HideWorkbench"
                        Style="{StaticResource InstrumentCommand}" Content="트레이로 보내기" Click="HideWorkbenchClicked" />
                </WrapPanel>
            </DockPanel>
            <TextBlock x:Name="ThemeSyncNotice" Visibility="Collapsed" Text="테마를 적용하려면 Aegis를 종료하고 다시 열어 주세요."
                       Foreground="{DynamicResource InstrumentAccent}" AutomationProperties.LiveSetting="Polite"
                       FontSize="12" TextWrapping="Wrap" Margin="0,3,0,2" />
            </StackPanel>
        </Border>
        <wv:WebView2 Grid.Row="1" x:Name="Dashboard" DefaultBackgroundColor="#101B27" />
        <Border Grid.Row="1" x:Name="ConnectionPanel" Background="{DynamicResource InstrumentSurface}" Padding="36">
            <StackPanel MaxWidth="520" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="계측 작업대" Foreground="{DynamicResource InstrumentInk}"
                           FontSize="21" FontWeight="SemiBold" Margin="0,0,0,12" />
                <TextBlock x:Name="ConnectionMessage" Text="로컬 대시보드에 연결하고 있습니다."
                           Foreground="{DynamicResource InstrumentMuted}" TextWrapping="Wrap" FontSize="14" />
                <WrapPanel Margin="0,16,0,0">
                    <Button Style="{StaticResource InstrumentCommand}" Content="다시 연결" Click="RetryClicked" Margin="0,0,8,0" />
                    <Button Style="{StaticResource InstrumentCommand}" Content="기존 모니터 열기" Click="LegacyClicked" />
                </WrapPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
